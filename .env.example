OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: model overrides. These are the only supported model config path for now.
YOLORAG_OPENAI_FAST_MODEL=gpt-5.4-mini
YOLORAG_OPENAI_THINKING_MODEL=gpt-5.5
YOLORAG_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
YOLORAG_DEEPSEEK_THINKING_MODEL=deepseek-v4-pro

# Optional: FastAPI defaults.
YOLORAG_API_PROVIDER=deepseek
YOLORAG_API_MODE=fast
YOLORAG_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Defaults to YOLORAG_KNOWLEDGE_PROVIDER when unset. Use mongodb or postgresql.
YOLORAG_CONVERSATION_PROVIDER=

# MongoDB Atlas / RAG retrieval.
YOLORAG_KNOWLEDGE_PROVIDER=mongodb
YOLORAG_MONGODB_URI=
# Required for reranking; VOYAGE_API_KEY is also accepted by the reranker.
YOLORAG_MONGODB_AI_API_KEY=
YOLORAG_MONGODB_DB=yolorag
YOLORAG_MONGODB_CHUNKS_COLLECTION=docs_chunks
YOLORAG_MONGODB_MESSAGES_COLLECTION=chat_messages
YOLORAG_MONGODB_VECTOR_INDEX=autoembed_index
YOLORAG_EMBEDDING_MODEL=voyage-4
YOLORAG_RERANK_MODEL=rerank-2.5-lite

# Optional: local PostgreSQL / pgvector retrieval.
YOLORAG_POSTGRES_DSN=postgresql+psycopg:///yolorag_pgvector
YOLORAG_POSTGRES_CHUNKS_TABLE=docs_chunks
YOLORAG_POSTGRES_EMBEDDING_MODEL=text-embedding-3-large
YOLORAG_POSTGRES_EMBEDDING_DIMENSIONS=3072
YOLORAG_EMBEDDING_BATCH_SIZE=64

# Optional: retrieval relevance tuning.
# Fast docs_search result count is capped in code for latency.
YOLORAG_CHAT_VECTOR_TOP_K=2
YOLORAG_RETRIEVAL_MIN_SCORE=0.50
# If unset, reranking uses max(40, top_k * 8) candidates. Try 16 or 32 to reduce rerank latency.
YOLORAG_RERANK_CANDIDATE_LIMIT=

# Optional: deep agent runtime.
YOLORAG_DEEP_MAX_STEPS=6
YOLORAG_DEEP_TOOL_TIMEOUT_SECONDS=20
# JSON object or array of MCP servers. Supports stdio servers, for example:
# {"local":{"command":"uvx","args":["some-mcp-server"],"env":{}}}
#
# Hosted GitHub MCP example using Streamable HTTP. Keep the server read-only first.
# GITHUB_MCP_TOKEN=
# [{"name":"github","type":"http","url":"https://api.githubcopilot.com/mcp/","allowed_repositories":["ultralytics/ultralytics"],"headers":{"Authorization":"Bearer ${GITHUB_MCP_TOKEN}","X-MCP-Toolsets":"repos,issues,pull_requests,actions","X-MCP-Readonly":"true"}}]
YOLORAG_MCP_SERVERS=

# Optional: Docker/Coolify compose defaults.
# Coolify auto-generates SERVICE_PASSWORD_POSTGRES. The frontend service is the
# public entrypoint; backend is still exposed locally for smoke tests.
POSTGRES_DB=yolorag
POSTGRES_USER=yolorag
# Coolify auto-generates this when referenced by docker-compose.coolify.yml.
SERVICE_PASSWORD_POSTGRES=
FRONTEND_PORT=8080
BACKEND_PORT=8000
