OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: model overrides. These are the only supported model config path for now.
YOLORAG_OPENAI_FAST_MODEL=gpt-5.4-mini
YOLORAG_OPENAI_THINKING_MODEL=gpt-5.5
YOLORAG_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
YOLORAG_DEEPSEEK_THINKING_MODEL=deepseek-v4-pro

# Optional: FastAPI defaults.
YOLORAG_API_PROVIDER=openai
YOLORAG_API_MODE=fast
YOLORAG_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
